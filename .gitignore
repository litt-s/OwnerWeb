# Dependencies
node_modules/
server/node_modules/
worker/node_modules/

# Build output
dist/
worker/.wrangler/

# Local environment / secrets（隐私与配置统一放 .env.local，由 npm run config 生成各配置）
.env
.env.local
.env.local.*
.env.production
.env.*.local
server/.env
worker/.dev.vars
worker/.secrets.json
# 由 .env.local 生成的 Worker 配置（保留 wrangler.toml.example 模板）
worker/wrangler.toml
# 保留示例文件
!.env.production.example

# Runtime data
server/data/
server/uploads/
*.db
*.db-shm
*.db-wal

# 私有资料（不提交）
AboutMe/
# 简历等个人文件（不提交、不推送）
*简历*.txt
*简历*.doc
*简历*.docx
*简历*.pdf
*resume*.txt
*resume*.pdf

# Logs and OS files
*.log
.DS_Store
Thumbs.db
