# API port
NODE_ENV=development
PORT=3001

# Public frontend origin(s), comma-separated when more than one is needed.
CORS_ORIGIN=http://localhost:5173

# Use absolute persistent paths in production.
DB_DIR=./data
UPLOAD_DIR=./uploads

# Required. Use a long random string in local and production environments.
JWT_SECRET=replace-with-a-long-random-secret

# Initial admin account. It is only created when both values are present.
ADMIN_EMAIL=
ADMIN_PASSWORD=
